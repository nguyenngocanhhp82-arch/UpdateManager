<Window x:Class="WinUpdateManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WinUpdateManager.App.ViewModels"
        mc:Ignorable="d"
        Title="Win Update Manager"
        Height="720"
        Width="1040"
        MinHeight="560"
        MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: App Header -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Main Tab Content -->
            <RowDefinition Height="*" />
            <!-- Row 2: Splitter / Separator -->
            <RowDefinition Height="Auto" />
            <!-- Row 3: Bottom Log Panel -->
            <RowDefinition Height="200" MinHeight="100" />
            <!-- Row 4: Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ROW 0: APP HEADER -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Win Update Manager" FontSize="18" FontWeight="Bold" Foreground="#111827" />
                    <TextBlock Text="Công cụ quản trị tập trung bản cập nhật Windows và ứng dụng hệ thống" FontSize="12" Foreground="#6B7280" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EEF2FF" CornerRadius="12" Padding="10,4">
                        <TextBlock Text="Quyền: Quản trị viên (Admin)" FontSize="11" FontWeight="SemiBold" Foreground="#4F46E5" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: 5 MAIN TABS -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Margin="16,10,16,6">
            <!-- TAB 1: CẬP NHẬT ỨNG DỤNG -->
            <TabItem Header="Cập nhật ứng dụng">
                <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Margin="0,10,0,0" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Quản lý cập nhật ứng dụng qua WinGet" FontSize="16" FontWeight="SemiBold" Foreground="#111827" />
                            <TextBlock Text="Quét và cài đặt các phiên bản mới nhất cho các phần mềm đã cài đặt trên máy tính." FontSize="12" Foreground="#6B7280" Margin="0,4,0,16" />
                        </StackPanel>

                        <Border Grid.Row="1" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="20">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Sẵn sàng cho Giai đoạn 2: WingetService &amp; Giao diện quản lý ứng dụng." FontSize="13" Foreground="#6B7280" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 2: WINDOWS UPDATE -->
            <TabItem Header="Windows Update">
                <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Margin="0,10,0,0" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Cập nhật hệ điều hành Windows" FontSize="16" FontWeight="SemiBold" Foreground="#111827" />
                            <TextBlock Text="Quét, tải và cài đặt các bản vá chất lượng và bảo mật từ Windows Update Agent." FontSize="12" Foreground="#6B7280" Margin="0,4,0,16" />
                        </StackPanel>

                        <Border Grid.Row="1" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="20">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Sẵn sàng cho Giai đoạn 3: WindowsUpdateService (COM API)." FontSize="13" Foreground="#6B7280" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 3: GỠ BẢN CẬP NHẬT WINDOWS -->
            <TabItem Header="Gỡ bản cập nhật Windows">
                <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Margin="0,10,0,0" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Gỡ bỏ bản vá lỗi và Rollback Windows" FontSize="16" FontWeight="SemiBold" Foreground="#111827" />
                            <TextBlock Text="Liệt kê danh sách bản vá KB đã cài đặt, hỗ trợ gỡ qua WUSA/DISM và tạo điểm phục hồi hệ thống." FontSize="12" Foreground="#6B7280" Margin="0,4,0,16" />
                        </StackPanel>

                        <Border Grid.Row="1" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="20">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Sẵn sàng cho Giai đoạn 3: HotfixService, gỡ KB và chặn cài lại." FontSize="13" Foreground="#6B7280" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 4: ỨNG DỤNG ĐÃ CÀI / ROLLBACK -->
            <TabItem Header="Ứng dụng đã cài / Rollback">
                <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Margin="0,10,0,0" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Danh sách phần mềm và quay về phiên bản cũ" FontSize="16" FontWeight="SemiBold" Foreground="#111827" />
                            <TextBlock Text="Tra cứu các phiên bản có sẵn của phần mềm và khôi phục về phiên bản mong muốn." FontSize="12" Foreground="#6B7280" Margin="0,4,0,16" />
                        </StackPanel>

                        <Border Grid.Row="1" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="20">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Sẵn sàng cho Giai đoạn 2: Rollback ứng dụng &amp; Quản lý ghim phiên bản (Pin)." FontSize="13" Foreground="#6B7280" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 5: TÙY CHỈNH CẬP NHẬT -->
            <TabItem Header="Tùy chỉnh cập nhật">
                <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Margin="0,10,0,0" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Chính sách cập nhật và Lịch tự động" FontSize="16" FontWeight="SemiBold" Foreground="#111827" />
                            <TextBlock Text="Tùy chỉnh chế độ cập nhật, hoãn nâng cấp, khóa phiên bản tính năng và đặt lịch nâng cấp tự động." FontSize="12" Foreground="#6B7280" Margin="0,4,0,16" />
                        </StackPanel>

                        <Border Grid.Row="1" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="20">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Sẵn sàng cho Giai đoạn 4: PolicyService &amp; ScheduleService." FontSize="13" Foreground="#6B7280" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- ROW 2: SPLITTER / SEPARATOR -->
        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" Background="#E5E7EB" ShowsPreview="True" />

        <!-- ROW 3: REALTIME LOG PANEL -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="0,2,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Log Panel Header -->
                <Border Grid.Row="0" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="16,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Nhật ký hoạt động" FontSize="13" FontWeight="SemiBold" Foreground="#111827" />
                            <TextBlock Text="{Binding LogEntries.Count, StringFormat=' ({0} dòng)'}" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Xóa" Style="{StaticResource SecondaryButton}" Command="{Binding ClearLogsCommand}" Margin="0,0,6,0" />
                            <Button Content="Sao chép" Style="{StaticResource SecondaryButton}" Command="{Binding CopyLogsCommand}" Margin="0,0,6,0" />
                            <Button Content="Mở thư mục log" Style="{StaticResource SecondaryButton}" Command="{Binding OpenLogFolderCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Log Items List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="8">
                    <ItemsControl ItemsSource="{Binding LogEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="75" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Timestamp -->
                                    <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='HH:mm:ss'}" FontSize="11" FontFamily="Consolas, monospace" Foreground="#9CA3AF" VerticalAlignment="Top" />

                                    <!-- Level Badge -->
                                    <TextBlock Grid.Column="1" Text="{Binding Level, StringFormat='[{0}]'}" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}}" VerticalAlignment="Top" />

                                    <!-- Message Content -->
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="12" FontFamily="Consolas, Segoe UI, sans-serif" Foreground="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}}" TextWrapping="Wrap" VerticalAlignment="Top" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ROW 4: STATUS BAR -->
        <Border Grid.Row="4" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status Text -->
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="12" Foreground="#4B5563" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <!-- Indeterminate Progress when Busy -->
                <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="120" Height="14" Margin="12,0" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center" />

                <!-- Cancel Button when Busy -->
                <Button Grid.Column="2" Content="Hủy tác vụ" Style="{StaticResource DangerButton}" Command="{Binding CancelProcessCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
