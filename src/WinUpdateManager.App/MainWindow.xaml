<Window x:Class="WinUpdateManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WinUpdateManager.App.ViewModels"
        mc:Ignorable="d"
        Title="Win Update Manager"
        Height="780"
        Width="1100"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: App Header -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Main Tab Content -->
            <RowDefinition Height="*" />
            <!-- Row 2: Splitter / Separator -->
            <RowDefinition Height="Auto" />
            <!-- Row 3: Bottom Log Panel -->
            <RowDefinition Height="180" MinHeight="90" />
            <!-- Row 4: Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ROW 0: APP HEADER -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Win Update Manager" FontSize="18" FontWeight="Bold" Foreground="#111827" />
                    <TextBlock Text="Công cụ quản trị tập trung bản cập nhật Windows và ứng dụng hệ thống" FontSize="12" Foreground="#6B7280" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EEF2FF" CornerRadius="12" Padding="10,4">
                        <TextBlock Text="Quyền: Quản trị viên (Admin)" FontSize="11" FontWeight="SemiBold" Foreground="#4F46E5" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: 5 MAIN TABS -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Margin="16,8,16,4">

            <!-- ========================================== -->
            <!-- TAB 1: CẬP NHẬT ỨNG DỤNG                   -->
            <!-- ========================================== -->
            <TabItem Header="Cập nhật ứng dụng">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <!-- WhatsApp Hero Card -->
                        <RowDefinition Height="Auto" />
                        <!-- Winget Upgrades List -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- WHATSAPP HERO CARD -->
                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#86EFAC" BorderThickness="1.5" CornerRadius="6" Padding="16,12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#25D366" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="WHATSAPP" FontWeight="Bold" Foreground="#FFFFFF" FontSize="11" />
                                    </Border>
                                    <TextBlock Text="Khu vực cập nhật siêu tốc WhatsApp Desktop" FontWeight="Bold" FontSize="14" Foreground="#111827" VerticalAlignment="Center" />
                                </StackPanel>

                                <Button Grid.Column="1" Content="Làm mới trạng thái" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshWhatsAppStatusCommand}" />
                            </Grid>

                            <StackPanel Grid.Row="1" Margin="0,8,0,10">
                                <TextBlock Text="{Binding WhatsAppInfoText}" FontSize="12" Foreground="#374151" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding WhatsAppCachedBadgeText}" FontSize="11" Foreground="#059669" Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- WhatsApp Action Buttons -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <!-- NÚT 1: CẬP NHẬT SIÊU TỐC (Tự động tải về nếu chưa có gói, cài trong 3-5 giây) -->
                                <Button Content="⚡ Cập nhật siêu tốc WhatsApp" Command="{Binding FastUpdateWhatsAppCommand}" Padding="16,7" Margin="0,0,10,0" ToolTip="Tự động kiểm tra gói trong Cache/LAN; nếu chưa có sẽ tự tải về và cài đặt trực tiếp không qua Store (hoạt động ngay cả khi Windows Update bị WUB tắt)." />
                                <!-- NÚT 2: Cài từ file Offline tùy chọn -->
                                <Button Content="📁 Cài từ tệp Offline..." Style="{StaticResource SecondaryButton}" Command="{Binding UpdateWhatsAppFromFileCommand}" Margin="0,0,10,0" ToolTip="Chọn file .msixbundle hoặc .exe từ USB/ổ đĩa để cài tức thì." />
                                <!-- NÚT 3: Tải file gói cài đặt về máy/LAN -->
                                <Button Content="⬇ Tải gói cài về Cache/LAN" Style="{StaticResource SecondaryButton}" Command="{Binding DownloadWhatsAppPackageCommand}" ToolTip="Tải gói cài đặt 1 lần duy nhất để chia sẻ cho các máy khác trong văn phòng." />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ALL APP UPGRADES SECTION -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Toolbar -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Tìm kiếm:" VerticalAlignment="Center" FontSize="12" Foreground="#4B5563" Margin="0,0,6,0" />
                                    <TextBox Text="{Binding SearchUpgradeFilter, UpdateSourceTrigger=PropertyChanged}" Width="160" Height="26" VerticalContentAlignment="Center" Padding="4,2" />
                                    <CheckBox Content="Bao gồm bản chưa rõ (--include-unknown)" IsChecked="{Binding IncludeUnknown}" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="🔍 Quét bản mới" Style="{StaticResource SecondaryButton}" Command="{Binding ScanUpgradesCommand}" Margin="0,0,6,0" />
                                    <Button Content="Cập nhật đã chọn" Command="{Binding UpgradeSelectedCommand}" Margin="0,0,6,0" />
                                    <Button Content="Cập nhật tất cả" Command="{Binding UpgradeAllCommand}" Margin="0,0,6,0" />
                                    <Button Content="Nhóm ưu tiên" Style="{StaticResource SecondaryButton}" Command="{Binding UpgradePriorityGroupCommand}" ToolTip="Chỉ cập nhật nhóm WhatsApp, Chrome, Zalo" />
                                </StackPanel>
                            </Grid>

                            <!-- Upgrades DataGrid/ListView -->
                            <ListView Grid.Row="1" ItemsSource="{Binding UpgradableApps}" BorderBrush="#E5E7EB">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Chọn" Width="45">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Tên ứng dụng" Width="200">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Mã định danh (ID)" Width="190" DisplayMemberBinding="{Binding Id}" />
                                        <GridViewColumn Header="Bản hiện tại" Width="100" DisplayMemberBinding="{Binding CurrentVersion}" />
                                        <GridViewColumn Header="Bản mới" Width="100">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding AvailableVersion}" FontWeight="Bold" Foreground="#16A34A" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Nguồn" Width="75" DisplayMemberBinding="{Binding Source}" />
                                        <GridViewColumn Header="Thao tác" Width="180">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Cập nhật" Command="{Binding DataContext.UpgradeSingleAppCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="8,3" FontSize="11" Margin="0,0,6,0" />
                                                        <Button Content="{Binding IsPinned, Converter={x:Null}}" Style="{StaticResource SecondaryButton}" Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="6,3" FontSize="11">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="3" Padding="6,2">
                                                                        <TextBlock Text="{Binding IsPinned, Converter={x:Null}}" FontSize="11">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Text" Value="Ghim (Pin)" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                                            <Setter Property="Text" Value="Bỏ ghim" />
                                                                                            <Setter Property="Foreground" Value="#DC2626" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================================== -->
            <!-- TAB 2: WINDOWS UPDATE                      -->
            <!-- ========================================== -->
            <TabItem Header="Windows Update">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <!-- Banner / Reboot Banner -->
                        <RowDefinition Height="Auto" />
                        <!-- Main Updates Card -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- REBOOT REQUIRED BANNER (if needed) -->
                    <Border Grid.Row="0" Background="#FEF2F2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,10" Visibility="{Binding RebootRequired, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="⚠️ CẦN KHỞI ĐỘNG LẠI MÁY TÍNH" FontWeight="Bold" FontSize="13" Foreground="#B91C1C" />
                                <TextBlock Text="Các bản vá Windows Update đã cài đặt xong. Vui lòng khởi động lại để hoàn tất cấu hình hệ thống." FontSize="12" Foreground="#7F1D1D" Margin="0,2,0,0" />
                            </StackPanel>

                            <Button Grid.Column="1" Content="Khởi động lại ngay" Style="{StaticResource DangerButton}" Command="{Binding RestartComputerCommand}" Padding="12,6" />
                        </Grid>
                    </Border>

                    <!-- MAIN WINDOWS UPDATE CARD -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Toolbar -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding WindowsUpdateSummary}" FontSize="13" FontWeight="SemiBold" Foreground="#111827" />
                                    <CheckBox Content="Xem danh sách các bản cập nhật đã ẩn" IsChecked="{Binding ShowHiddenWindowsUpdates}" VerticalAlignment="Center" Margin="0,4,0,0" FontSize="12" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="🔍 Quét Windows Update" Style="{StaticResource SecondaryButton}" Command="{Binding ScanWindowsUpdatesCommand}" Margin="0,0,6,0" />
                                    <Button Content="Cài đặt đã chọn" Command="{Binding InstallSelectedWindowsUpdatesCommand}" Margin="0,0,6,0" />
                                    <Button Content="Cài đặt tất cả" Command="{Binding InstallAllWindowsUpdatesCommand}" />
                                </StackPanel>
                            </Grid>

                            <!-- Windows Updates List -->
                            <ListView Grid.Row="1" ItemsSource="{Binding WindowsUpdates}" BorderBrush="#E5E7EB">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Chọn" Width="45">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Tiêu đề bản cập nhật" Width="420">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Mã KB" Width="100" DisplayMemberBinding="{Binding KbArticleId}" />
                                        <GridViewColumn Header="Phân loại" Width="90" DisplayMemberBinding="{Binding Category}" />
                                        <GridViewColumn Header="Dung lượng" Width="100" DisplayMemberBinding="{Binding SizeDisplay}" />
                                        <GridViewColumn Header="Thao tác" Width="120">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding IsHidden, Converter={x:Null}}" Style="{StaticResource SecondaryButton}" Command="{Binding DataContext.ToggleHideWindowsUpdateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="6,3" FontSize="11">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="3" Padding="6,2">
                                                                    <TextBlock FontSize="11">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Text" Value="Ẩn bản vá" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                                                        <Setter Property="Text" Value="Bỏ ẩn" />
                                                                                        <Setter Property="Foreground" Value="#059669" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                              
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================================== -->
            <!-- TAB 3: GỠ BẢN CẬP NHẬT WINDOWS             -->
            <!-- ========================================== -->
            <TabItem Header="Gỡ bản cập nhật Windows">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <!-- Top Options Card -->
                        <RowDefinition Height="Auto" />
                        <!-- Installed Hotfixes / DISM Table -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- TOP OPTIONS CARD -->
                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox Content="Tự động tạo Điểm phục hồi hệ thống (Restore Point) trước khi gỡ" IsChecked="{Binding AutoCreateRestorePoint}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Margin="0,0,16,0" />
                                    <CheckBox Content="Chặn cài lại (Tự động Ẩn bản vá trên Windows Update)" IsChecked="{Binding AutoBlockReinstall}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" />
                                </StackPanel>

                                <Button Grid.Column="1" Content="🛡 Tạo Restore Point thủ công" Style="{StaticResource SecondaryButton}" Command="{Binding CreateRestorePointCommand}" />
                            </Grid>

                            <!-- View Mode Selector -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Chế độ xem:" VerticalAlignment="Center" FontSize="12" Foreground="#4B5563" Margin="0,0,10,0" />
                                <RadioButton Content="Danh sách bản vá KB (WMI QuickFixEngineering)" IsChecked="{Binding IsDismMode, Converter={StaticResource InverseBooleanConverter}}" VerticalAlignment="Center" Margin="0,0,14,0" FontSize="12" />
                                <RadioButton Content="Gói hệ thống nâng cao (DISM Packages)" IsChecked="{Binding IsDismMode}" VerticalAlignment="Center" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- WMI HOTFIX VIEW (Default) -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="14" Visibility="{Binding IsDismMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Toolbar -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Tìm kiếm bản vá:" VerticalAlignment="Center" FontSize="12" Foreground="#4B5563" Margin="0,0,6,0" />
                                    <TextBox Text="{Binding SearchHotfixFilter, UpdateSourceTrigger=PropertyChanged}" Width="200" Height="26" VerticalContentAlignment="Center" Padding="4,2" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="🔄 Tải lại danh sách KB" Style="{StaticResource SecondaryButton}" Command="{Binding LoadInstalledHotfixesCommand}" />
                                </StackPanel>
                            </Grid>

                            <!-- Installed KBs List -->
                            <ListView Grid.Row="1" ItemsSource="{Binding InstalledHotfixes}" BorderBrush="#E5E7EB">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Mã KB" Width="130">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding HotFixId}" FontWeight="Bold" Foreground="#1E40AF" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Mô tả bản vá" Width="280" DisplayMemberBinding="{Binding Description}" />
                                        <GridViewColumn Header="Ngày cài đặt" Width="140" DisplayMemberBinding="{Binding InstalledOn}" />
                                        <GridViewColumn Header="Cài bởi" Width="140" DisplayMemberBinding="{Binding InstalledBy}" />
                                        <GridViewColumn Header="Thao tác" Width="130">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Gỡ bỏ" Style="{StaticResource DangerButton}" Command="{Binding DataContext.UninstallHotfixCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="8,3" FontSize="11" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- DISM PACKAGES VIEW (Advanced) -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="14" Visibility="{Binding IsDismMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Alert & Toolbar -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Gợi ý: Dùng DISM để gỡ các bản Cumulative Update (RollupFix) mà wusa không gỡ được." FontSize="12" Foreground="#B45309" VerticalAlignment="Center" />

                                <Button Grid.Column="1" Content="🔍 Quét gói DISM" Style="{StaticResource SecondaryButton}" Command="{Binding LoadDismPackagesCommand}" />
                            </Grid>

                            <!-- DISM Packages List -->
                            <ListView Grid.Row="1" ItemsSource="{Binding DismPackages}" BorderBrush="#E5E7EB">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Tên gói hệ thống (Package Identity)" Width="460">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding PackageName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Trạng thái" Width="100" DisplayMemberBinding="{Binding State}" />
                                        <GridViewColumn Header="Loại phát hành" Width="120" DisplayMemberBinding="{Binding ReleaseType}" />
                                        <GridViewColumn Header="Thời gian cài" Width="140" DisplayMemberBinding="{Binding InstallTime}" />
                                        <GridViewColumn Header="Thao tác" Width="120">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Gỡ gói DISM" Style="{StaticResource DangerButton}" Command="{Binding DataContext.RemoveDismPackageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="8,3" FontSize="11" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================================== -->
            <!-- TAB 4: ỨNG DỤNG ĐÃ CÀI / ROLLBACK          -->
            <!-- ========================================== -->
            <TabItem Header="Ứng dụng đã cài / Rollback">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <!-- Rollback Drawer if open -->
                        <RowDefinition Height="Auto" />
                        <!-- Installed Apps List -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- ROLLBACK SELECTION DRAWER -->
                    <Border Grid.Row="0" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,10" Visibility="{Binding IsRollbackPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="Quay về phiên bản cũ (Rollback): " FontWeight="Bold" FontSize="13" Foreground="#92400E" />
                                    <TextBlock Text="{Binding SelectedInstalledApp.Name}" FontWeight="Bold" FontSize="13" Foreground="#111827" />
                                    <TextBlock Text="{Binding SelectedInstalledApp.Id, StringFormat=' [{0}]'}" FontSize="12" Foreground="#6B7280" Margin="4,0,0,0" />
                                </StackPanel>

                                <Button Grid.Column="1" Content="✕ Đóng" Style="{StaticResource SecondaryButton}" Command="{Binding CloseRollbackPanelCommand}" Padding="8,2" FontSize="11" />
                            </Grid>

                            <StackPanel Grid.Row="1" Margin="0,8,0,8">
                                <TextBlock Text="Lưu ý: Ứng dụng từ Microsoft Store thường không hỗ trợ chọn phiên bản cũ qua winget." FontSize="11" Foreground="#B45309" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Chọn phiên bản muốn cài đặt:" VerticalAlignment="Center" FontSize="12" Foreground="#374151" Margin="0,0,8,0" />
                                    <ComboBox ItemsSource="{Binding AvailableVersions}" SelectedItem="{Binding SelectedRollbackVersion}" Width="160" Height="26" VerticalContentAlignment="Center" />
                                    <CheckBox Content="Ghim phiên bản này sau khi rollback (Pin)" IsChecked="{Binding PinAfterRollback}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="Thực hiện Rollback" Command="{Binding ExecuteRollbackCommand}" Padding="12,5" Margin="0,0,8,0" />
                                <Button Content="Hủy" Style="{StaticResource SecondaryButton}" Command="{Binding CloseRollbackPanelCommand}" Padding="10,5" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- INSTALLED APPS TABLE -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Toolbar -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Tìm kiếm ứng dụng:" VerticalAlignment="Center" FontSize="12" Foreground="#4B5563" Margin="0,0,6,0" />
                                    <TextBox Text="{Binding SearchInstalledFilter, UpdateSourceTrigger=PropertyChanged}" Width="200" Height="26" VerticalContentAlignment="Center" Padding="4,2" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="🔄 Tải lại danh sách" Style="{StaticResource SecondaryButton}" Command="{Binding LoadInstalledAppsCommand}" />
                                </StackPanel>
                            </Grid>

                            <!-- Installed Apps List -->
                            <ListView Grid.Row="1" ItemsSource="{Binding InstalledApps}" BorderBrush="#E5E7EB">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Tên ứng dụng" Width="260">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Mã định danh (ID)" Width="220" DisplayMemberBinding="{Binding Id}" />
                                        <GridViewColumn Header="Phiên bản hiện tại" Width="130" DisplayMemberBinding="{Binding CurrentVersion}" />
                                        <GridViewColumn Header="Nguồn" Width="80" DisplayMemberBinding="{Binding Source}" />
                                        <GridViewColumn Header="Thao tác" Width="190">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Rollback..." Style="{StaticResource SecondaryButton}" Command="{Binding DataContext.OpenRollbackDialogCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="8,3" FontSize="11" Margin="0,0,6,0" />
                                                        <Button Content="Gỡ cài đặt" Style="{StaticResource DangerButton}" Command="{Binding DataContext.UninstallAppCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="8,3" FontSize="11" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================================== -->
            <!-- TAB 5: TÙY CHỈNH CẬP NHẬT                  -->
            <!-- ========================================== -->
            <TabItem Header="Tùy chỉnh cập nhật">
                <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Margin="0,8,0,0" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Chính sách cập nhật và Lịch tự động" FontSize="16" FontWeight="SemiBold" Foreground="#111827" />
                            <TextBlock Text="Tùy chỉnh chế độ cập nhật, hoãn nâng cấp, khóa phiên bản tính năng và đặt lịch nâng cấp tự động." FontSize="12" Foreground="#6B7280" Margin="0,4,0,16" />
                        </StackPanel>

                        <Border Grid.Row="1" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="20">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Sẵn sàng cho Giai đoạn 4: PolicyService &amp; ScheduleService." FontSize="13" Foreground="#6B7280" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- ROW 2: SPLITTER / SEPARATOR -->
        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" Background="#E5E7EB" ShowsPreview="True" />

        <!-- ROW 3: REALTIME LOG PANEL -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="0,2,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Log Panel Header -->
                <Border Grid.Row="0" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="16,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Nhật ký hoạt động" FontSize="13" FontWeight="SemiBold" Foreground="#111827" />
                            <TextBlock Text="{Binding LogEntries.Count, StringFormat=' ({0} dòng)'}" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Xóa" Style="{StaticResource SecondaryButton}" Command="{Binding ClearLogsCommand}" Margin="0,0,6,0" />
                            <Button Content="Sao chép" Style="{StaticResource SecondaryButton}" Command="{Binding CopyLogsCommand}" Margin="0,0,6,0" />
                            <Button Content="Mở thư mục log" Style="{StaticResource SecondaryButton}" Command="{Binding OpenLogFolderCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Log Items List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="8">
                    <ItemsControl ItemsSource="{Binding LogEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="75" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Timestamp -->
                                    <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='HH:mm:ss'}" FontSize="11" FontFamily="Consolas, monospace" Foreground="#9CA3AF" VerticalAlignment="Top" />

                                    <!-- Level Badge -->
                                    <TextBlock Grid.Column="1" Text="{Binding Level, StringFormat='[{0}]'}" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}}" VerticalAlignment="Top" />

                                    <!-- Message Content -->
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="12" FontFamily="Consolas, Segoe UI, sans-serif" Foreground="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}}" TextWrapping="Wrap" VerticalAlignment="Top" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ROW 4: STATUS BAR -->
        <Border Grid.Row="4" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status Text -->
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="12" Foreground="#4B5563" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <!-- Indeterminate Progress when Busy -->
                <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="120" Height="14" Margin="12,0" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center" />

                <!-- Cancel Button when Busy -->
                <Button Grid.Column="2" Content="Hủy tác vụ" Style="{StaticResource DangerButton}" Command="{Binding CancelProcessCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
