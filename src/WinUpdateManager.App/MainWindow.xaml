<Window x:Class="WinUpdateManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WinUpdateManager.App.ViewModels"
        mc:Ignorable="d"
        Title="Win Update Manager"
        Icon="Assets/app.ico"
        Height="800"
        Width="1120"
        MinHeight="620"
        MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: App Header -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Main Tab Content -->
            <RowDefinition Height="*" />
            <!-- Row 2: Splitter / Separator -->
            <RowDefinition Height="Auto" />
            <!-- Row 3: Bottom Log Panel -->
            <RowDefinition Height="180" MinHeight="90" />
            <!-- Row 4: Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ROW 0: APP HEADER -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Win Update Manager" FontSize="18" FontWeight="Bold" Foreground="#111827" />
                    <TextBlock Text="Công cụ quản trị tập trung bản cập nhật Windows và ứng dụng hệ thống" FontSize="12" Foreground="#6B7280" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Nút/Huy hiệu trạng thái Windows Update (WUB Mode) -->
                    <Button Command="{Binding NavigateToPoliciesTabCommand}"
                            Cursor="Hand" Margin="0,0,10,0" ToolTip="Xem trạng thái và cấu hình Bật/Khóa Windows Update (Chế độ tương thích WUB)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{Binding WindowsUpdateBadgeBackground}"
                                        BorderBrush="{Binding WindowsUpdateBadgeBorder}"
                                        BorderThickness="1.5"
                                        CornerRadius="12"
                                        Padding="10,4">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding WindowsUpdateBadgeIcon}" FontSize="12" Margin="0,0,5,0" />
                                        <TextBlock Text="{Binding WindowsUpdateBadgeText}" FontSize="11" FontWeight="Bold" Foreground="{Binding WindowsUpdateBadgeForeground}" />
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Border Background="#EEF2FF" CornerRadius="12" Padding="10,4">
                        <TextBlock Text="Quyền: Quản trị viên (Admin)" FontSize="11" FontWeight="SemiBold" Foreground="#4F46E5" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: 5 MAIN TABS -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Margin="16,8,16,4">

            <!-- ========================================== -->
            <!-- TAB 1: CẬP NHẬT ỨNG DỤNG                   -->
            <!-- ========================================== -->
            <TabItem Header="Cập nhật ứng dụng">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <!-- WhatsApp Hero Card -->
                        <RowDefinition Height="Auto" />
                        <!-- Winget Upgrades List -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- WHATSAPP HERO CARD -->
                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#86EFAC" BorderThickness="1.5" CornerRadius="6" Padding="16,12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#25D366" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="WHATSAPP" FontWeight="Bold" Foreground="#FFFFFF" FontSize="11" />
                                    </Border>
                                    <TextBlock Text="Khu vực cập nhật siêu tốc WhatsApp Desktop" FontWeight="Bold" FontSize="14" Foreground="#111827" VerticalAlignment="Center" />
                                </StackPanel>

                                <Button Grid.Column="1" Content="Làm mới trạng thái" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshWhatsAppStatusCommand}" />
                            </Grid>

                            <StackPanel Grid.Row="1" Margin="0,8,0,10">
                                <TextBlock Text="{Binding WhatsAppInfoText}" FontSize="12" Foreground="#374151" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding WhatsAppCachedBadgeText}" FontSize="11" Foreground="#059669" Margin="0,2,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Trạng thái dịch vụ cập nhật: " FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding WindowsUpdateBadgeText}" FontSize="11" FontWeight="Bold" Foreground="{Binding WindowsUpdateBadgeForeground}" VerticalAlignment="Center" Margin="2,0,6,0" />
                                    <TextBlock Text="• Tự động phá khóa WUB an toàn khi cập nhật" FontSize="11" Foreground="#059669" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <!-- WhatsApp Action Buttons -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <!-- NÚT 1: CẬP NHẬT SIÊU TỐC (Tự động tải về nếu chưa có gói, cài trong 3-5 giây) -->
                                <Button Content="⚡ Cập nhật siêu tốc WhatsApp" Command="{Binding FastUpdateWhatsAppCommand}" Padding="16,7" Margin="0,0,10,0" ToolTip="Tự động kiểm tra gói trong Cache/LAN; nếu chưa có sẽ tự tải về và cài đặt trực tiếp không qua Store (hoạt động ngay cả khi Windows Update bị WUB tắt)." />
                                <!-- NÚT 2: Cài từ file Offline tùy chọn -->
                                <Button Content="📁 Cài từ tệp Offline..." Style="{StaticResource SecondaryButton}" Command="{Binding UpdateWhatsAppFromFileCommand}" Margin="0,0,10,0" ToolTip="Chọn file .msixbundle hoặc .exe từ USB/ổ đĩa để cài tức thì." />
                                <!-- NÚT 3: Tải file gói cài đặt về máy/LAN -->
                                <Button Content="⬇ Tải gói cài về Cache/LAN" Style="{StaticResource SecondaryButton}" Command="{Binding DownloadWhatsAppPackageCommand}" ToolTip="Tải gói cài đặt 1 lần duy nhất để chia sẻ cho các máy khác trong văn phòng." />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ALL APP UPGRADES SECTION -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Toolbar -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Tìm kiếm:" VerticalAlignment="Center" FontSize="12" Foreground="#4B5563" Margin="0,0,6,0" />
                                    <TextBox Text="{Binding SearchUpgradeFilter, UpdateSourceTrigger=PropertyChanged}" Width="160" Height="26" VerticalContentAlignment="Center" Padding="4,2" />
                                    <CheckBox Content="Bao gồm bản chưa rõ (--include-unknown)" IsChecked="{Binding IncludeUnknown}" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="🔍 Quét bản mới" Style="{StaticResource SecondaryButton}" Command="{Binding ScanUpgradesCommand}" Margin="0,0,6,0" />
                                    <Button Content="Chọn tất cả" Style="{StaticResource SecondaryButton}" Command="{Binding SelectAllUpgradesCommand}" Margin="0,0,6,0" ToolTip="Tích chọn các ứng dụng an toàn" />
                                    <Button Content="Bỏ chọn hết" Style="{StaticResource SecondaryButton}" Command="{Binding DeselectAllUpgradesCommand}" Margin="0,0,10,0" ToolTip="Bỏ tích chọn toàn bộ ứng dụng" />
                                    <Button Content="⚡ Cập nhật các app đã chọn" Command="{Binding UpgradeSelectedCommand}" Padding="14,6" ToolTip="Chỉ cập nhật ĐÚNG những ứng dụng bạn đã tích chọn dấu kiểm ở cột đầu tiên." />
                                </StackPanel>
                            </Grid>

                            <!-- Upgrades DataGrid/ListView -->
                            <ListView Grid.Row="1" ItemsSource="{Binding UpgradableApps}" BorderBrush="#E5E7EB">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Chọn" Width="45">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Tên ứng dụng" Width="220">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding WarningNote}" FontSize="10" Foreground="#D97706" Visibility="{Binding IsExcluded, Converter={StaticResource BooleanToVisibilityConverter}}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Mã định danh (ID)" Width="190" DisplayMemberBinding="{Binding Id}" />
                                        <GridViewColumn Header="Bản hiện tại" Width="100" DisplayMemberBinding="{Binding CurrentVersion}" />
                                        <GridViewColumn Header="Bản mới" Width="100">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding AvailableVersion}" FontWeight="Bold" Foreground="#16A34A" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Nguồn" Width="75" DisplayMemberBinding="{Binding Source}" />
                                        <GridViewColumn Header="Thao tác" Width="180">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Cập nhật" Command="{Binding DataContext.UpgradeSingleAppCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="8,3" FontSize="11" Margin="0,0,6,0" />
                                                        <Button Content="{Binding IsPinned, Converter={x:Null}}" Style="{StaticResource SecondaryButton}" Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="6,3" FontSize="11">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="3" Padding="6,2">
                                                                        <TextBlock Text="{Binding IsPinned, Converter={x:Null}}" FontSize="11">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Text" Value="Ghim (Pin)" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                                            <Setter Property="Text" Value="Bỏ ghim" />
                                                                                            <Setter Property="Foreground" Value="#DC2626" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================================== -->
            <!-- TAB 2: WINDOWS UPDATE                      -->
            <!-- ========================================== -->
            <TabItem Header="Windows Update">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <!-- Banner / Reboot Banner -->
                        <RowDefinition Height="Auto" />
                        <!-- Main Updates Card -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- REBOOT REQUIRED BANNER (if needed) -->
                    <Border Grid.Row="0" Background="#FEF2F2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,10" Visibility="{Binding RebootRequired, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="⚠️ CẦN KHỞI ĐỘNG LẠI MÁY TÍNH" FontWeight="Bold" FontSize="13" Foreground="#B91C1C" />
                                <TextBlock Text="Các bản vá Windows Update đã cài đặt xong. Vui lòng khởi động lại để hoàn tất cấu hình hệ thống." FontSize="12" Foreground="#7F1D1D" Margin="0,2,0,0" />
                            </StackPanel>

                            <Button Grid.Column="1" Content="Khởi động lại ngay" Style="{StaticResource DangerButton}" Command="{Binding RestartComputerCommand}" Padding="12,6" />
                        </Grid>
                    </Border>

                    <!-- MAIN WINDOWS UPDATE CARD -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Toolbar -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding WindowsUpdateSummary}" FontSize="13" FontWeight="SemiBold" Foreground="#111827" />
                                    <CheckBox Content="Xem danh sách các bản cập nhật đã ẩn" IsChecked="{Binding ShowHiddenWindowsUpdates}" VerticalAlignment="Center" Margin="0,4,0,0" FontSize="12" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="🔍 Quét Windows Update" Style="{StaticResource SecondaryButton}" Command="{Binding ScanWindowsUpdatesCommand}" Margin="0,0,6,0" />
                                    <Button Content="Cài đặt đã chọn" Command="{Binding InstallSelectedWindowsUpdatesCommand}" Margin="0,0,6,0" />
                                    <Button Content="Cài đặt tất cả" Command="{Binding InstallAllWindowsUpdatesCommand}" />
                                </StackPanel>
                            </Grid>

                            <!-- Windows Updates List -->
                            <ListView Grid.Row="1" ItemsSource="{Binding WindowsUpdates}" BorderBrush="#E5E7EB">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Chọn" Width="45">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Tiêu đề bản cập nhật" Width="420">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Mã KB" Width="100" DisplayMemberBinding="{Binding KbArticleId}" />
                                        <GridViewColumn Header="Phân loại" Width="90" DisplayMemberBinding="{Binding Category}" />
                                        <GridViewColumn Header="Dung lượng" Width="100" DisplayMemberBinding="{Binding SizeDisplay}" />
                                        <GridViewColumn Header="Thao tác" Width="120">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding IsHidden, Converter={x:Null}}" Style="{StaticResource SecondaryButton}" Command="{Binding DataContext.ToggleHideWindowsUpdateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="6,3" FontSize="11">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="3" Padding="6,2">
                                                                    <TextBlock FontSize="11">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Text" Value="Ẩn bản vá" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                                                        <Setter Property="Text" Value="Bỏ ẩn" />
                                                                                        <Setter Property="Foreground" Value="#059669" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================================== -->
            <!-- TAB 3: GỠ BẢN CẬP NHẬT WINDOWS             -->
            <!-- ========================================== -->
            <TabItem Header="Gỡ bản cập nhật Windows">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <!-- Top Options Card -->
                        <RowDefinition Height="Auto" />
                        <!-- Installed Hotfixes / DISM Table -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- TOP OPTIONS CARD -->
                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox Content="Tự động tạo Điểm phục hồi hệ thống (Restore Point) trước khi gỡ" IsChecked="{Binding AutoCreateRestorePoint}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Margin="0,0,16,0" />
                                    <CheckBox Content="Chặn cài lại (Tự động Ẩn bản vá trên Windows Update)" IsChecked="{Binding AutoBlockReinstall}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" />
                                </StackPanel>

                                <Button Grid.Column="1" Content="🛡 Tạo Restore Point thủ công" Style="{StaticResource SecondaryButton}" Command="{Binding CreateRestorePointCommand}" />
                            </Grid>

                            <!-- View Mode Selector -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Chế độ xem:" VerticalAlignment="Center" FontSize="12" Foreground="#4B5563" Margin="0,0,10,0" />
                                <RadioButton Content="Danh sách bản vá KB (WMI QuickFixEngineering)" IsChecked="{Binding IsDismMode, Converter={StaticResource InverseBooleanConverter}}" VerticalAlignment="Center" Margin="0,0,14,0" FontSize="12" />
                                <RadioButton Content="Gói hệ thống nâng cao (DISM Packages)" IsChecked="{Binding IsDismMode}" VerticalAlignment="Center" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- WMI HOTFIX VIEW (Default) -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="14" Visibility="{Binding IsDismMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Toolbar -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Tìm kiếm bản vá:" VerticalAlignment="Center" FontSize="12" Foreground="#4B5563" Margin="0,0,6,0" />
                                    <TextBox Text="{Binding SearchHotfixFilter, UpdateSourceTrigger=PropertyChanged}" Width="200" Height="26" VerticalContentAlignment="Center" Padding="4,2" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="🔄 Tải lại danh sách KB" Style="{StaticResource SecondaryButton}" Command="{Binding LoadInstalledHotfixesCommand}" />
                                </StackPanel>
                            </Grid>

                            <!-- Installed KBs List -->
                            <ListView Grid.Row="1" ItemsSource="{Binding InstalledHotfixes}" BorderBrush="#E5E7EB">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Mã KB" Width="130">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding HotFixId}" FontWeight="Bold" Foreground="#1E40AF" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Mô tả bản vá" Width="280" DisplayMemberBinding="{Binding Description}" />
                                        <GridViewColumn Header="Ngày cài đặt" Width="140" DisplayMemberBinding="{Binding InstalledOn}" />
                                        <GridViewColumn Header="Cài bởi" Width="140" DisplayMemberBinding="{Binding InstalledBy}" />
                                        <GridViewColumn Header="Thao tác" Width="130">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Gỡ bỏ" Style="{StaticResource DangerButton}" Command="{Binding DataContext.UninstallHotfixCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="8,3" FontSize="11" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- DISM PACKAGES VIEW (Advanced) -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="14" Visibility="{Binding IsDismMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Alert & Toolbar -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Gợi ý: Dùng DISM để gỡ các bản Cumulative Update (RollupFix) mà wusa không gỡ được." FontSize="12" Foreground="#B45309" VerticalAlignment="Center" />

                                <Button Grid.Column="1" Content="🔍 Quét gói DISM" Style="{StaticResource SecondaryButton}" Command="{Binding LoadDismPackagesCommand}" />
                            </Grid>

                            <!-- DISM Packages List -->
                            <ListView Grid.Row="1" ItemsSource="{Binding DismPackages}" BorderBrush="#E5E7EB">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Tên gói hệ thống (Package Identity)" Width="460">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding PackageName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Trạng thái" Width="100" DisplayMemberBinding="{Binding State}" />
                                        <GridViewColumn Header="Loại phát hành" Width="120" DisplayMemberBinding="{Binding ReleaseType}" />
                                        <GridViewColumn Header="Thời gian cài" Width="140" DisplayMemberBinding="{Binding InstallTime}" />
                                        <GridViewColumn Header="Thao tác" Width="120">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Gỡ gói DISM" Style="{StaticResource DangerButton}" Command="{Binding DataContext.RemoveDismPackageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="8,3" FontSize="11" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================================== -->
            <!-- TAB 4: ỨNG DỤNG ĐÃ CÀI / ROLLBACK          -->
            <!-- ========================================== -->
            <TabItem Header="Ứng dụng đã cài / Rollback">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <!-- Rollback Drawer if open -->
                        <RowDefinition Height="Auto" />
                        <!-- Installed Apps List -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- ROLLBACK SELECTION DRAWER -->
                    <Border Grid.Row="0" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,10" Visibility="{Binding IsRollbackPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="Quay về phiên bản cũ (Rollback): " FontWeight="Bold" FontSize="13" Foreground="#92400E" />
                                    <TextBlock Text="{Binding SelectedInstalledApp.Name}" FontWeight="Bold" FontSize="13" Foreground="#111827" />
                                    <TextBlock Text="{Binding SelectedInstalledApp.Id, StringFormat=' [{0}]'}" FontSize="12" Foreground="#6B7280" Margin="4,0,0,0" />
                                </StackPanel>

                                <Button Grid.Column="1" Content="✕ Đóng" Style="{StaticResource SecondaryButton}" Command="{Binding CloseRollbackPanelCommand}" Padding="8,2" FontSize="11" />
                            </Grid>

                            <StackPanel Grid.Row="1" Margin="0,8,0,8">
                                <TextBlock Text="Lưu ý: Ứng dụng từ Microsoft Store thường không hỗ trợ chọn phiên bản cũ qua winget." FontSize="11" Foreground="#B45309" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Chọn phiên bản muốn cài đặt:" VerticalAlignment="Center" FontSize="12" Foreground="#374151" Margin="0,0,8,0" />
                                    <ComboBox ItemsSource="{Binding AvailableVersions}" SelectedItem="{Binding SelectedRollbackVersion}" Width="160" Height="26" VerticalContentAlignment="Center" />
                                    <CheckBox Content="Ghim phiên bản này sau khi rollback (Pin)" IsChecked="{Binding PinAfterRollback}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="Thực hiện Rollback" Command="{Binding ExecuteRollbackCommand}" Padding="12,5" Margin="0,0,8,0" />
                                <Button Content="Hủy" Style="{StaticResource SecondaryButton}" Command="{Binding CloseRollbackPanelCommand}" Padding="10,5" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- INSTALLED APPS TABLE -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Toolbar -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Tìm kiếm ứng dụng:" VerticalAlignment="Center" FontSize="12" Foreground="#4B5563" Margin="0,0,6,0" />
                                    <TextBox Text="{Binding SearchInstalledFilter, UpdateSourceTrigger=PropertyChanged}" Width="200" Height="26" VerticalContentAlignment="Center" Padding="4,2" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="🔄 Tải lại danh sách" Style="{StaticResource SecondaryButton}" Command="{Binding LoadInstalledAppsCommand}" />
                                </StackPanel>
                            </Grid>

                            <!-- Installed Apps List -->
                            <ListView Grid.Row="1" ItemsSource="{Binding InstalledApps}" BorderBrush="#E5E7EB">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Tên ứng dụng" Width="260">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Mã định danh (ID)" Width="220" DisplayMemberBinding="{Binding Id}" />
                                        <GridViewColumn Header="Phiên bản hiện tại" Width="130" DisplayMemberBinding="{Binding CurrentVersion}" />
                                        <GridViewColumn Header="Nguồn" Width="80" DisplayMemberBinding="{Binding Source}" />
                                        <GridViewColumn Header="Thao tác" Width="190">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Rollback..." Style="{StaticResource SecondaryButton}" Command="{Binding DataContext.OpenRollbackDialogCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="8,3" FontSize="11" Margin="0,0,6,0" />
                                                        <Button Content="Gỡ cài đặt" Style="{StaticResource DangerButton}" Command="{Binding DataContext.UninstallAppCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="8,3" FontSize="11" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================================== -->
            <!-- TAB 5: TÙY CHỈNH CẬP NHẬT                  -->
            <!-- ========================================== -->
            <TabItem Header="Tùy chỉnh cập nhật">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,8,0,10">
                        <Grid.RowDefinitions>
                            <!-- Auto Upgrade Scheduled Task Card -->
                            <RowDefinition Height="Auto" />
                            <!-- Registry Policies Card -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- SCHEDULED TASK CARD (LỊCH TỰ ĐỘNG NÂNG CẤP) -->
                        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#3B82F6" BorderThickness="1.5" CornerRadius="6" Padding="16,14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="⏰ Lịch tự động nâng cấp ứng dụng (Scheduled Task)" FontWeight="Bold" FontSize="15" Foreground="#1E40AF" />
                                        <TextBlock Text="Chạy ngầm cập nhật WhatsApp và các phần mềm theo lịch định kỳ, tự động xử lý ngay cả khi bạn TẮT HOÀN TOÀN Windows Update." FontSize="12" Foreground="#4B5563" Margin="0,3,0,0" />
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="📋 Xem auto-upgrade.log" Style="{StaticResource SecondaryButton}" Command="{Binding ViewScheduleLogCommand}" />
                                </Grid>

                                <!-- Schedule Settings -->
                                <Border Grid.Row="1" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,10,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Chu kỳ:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="#0369A1" Margin="0,0,6,0" />
                                            <ComboBox SelectedValue="{Binding ScheduleModel.ScheduleType}" SelectedValuePath="Content" Width="100" Height="26" VerticalContentAlignment="Center">
                                                <ComboBoxItem Content="Daily" IsSelected="True" />
                                                <ComboBoxItem Content="Weekly" />
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Giờ chạy (HH:mm):" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="#0369A1" Margin="0,0,6,0" />
                                            <TextBox Text="{Binding ScheduleModel.ExecutionTime}" Width="70" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontWeight="Bold" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="💾 Lưu / Tạo lịch" Command="{Binding SaveScheduleCommand}" Margin="0,0,6,0" Padding="12,5" />
                                            <Button Content="🗑 Xóa lịch" Style="{StaticResource DangerButton}" Command="{Binding DeleteScheduleCommand}" Margin="0,0,6,0" Padding="10,5" />
                                            <Button Content="▶ Chạy thử ngay" Style="{StaticResource SecondaryButton}" Command="{Binding RunScheduleNowCommand}" Padding="10,5" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- App Selection for Scheduled Auto-Upgrade -->
                                <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Header & Toolbar -->
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="📋 Danh sách ứng dụng áp dụng theo lịch:" FontWeight="Bold" FontSize="13" Foreground="#1E3A8A" />
                                                <TextBlock Text="Tích chọn những ứng dụng bạn muốn tự động nâng cấp khi đến giờ hẹn (những ứng dụng không được tích sẽ không bao giờ tự động cập nhật)." FontSize="11" Foreground="#6B7280" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Chọn tất cả" Style="{StaticResource SecondaryButton}" Command="{Binding SelectAllScheduledAppsCommand}" Padding="8,3" FontSize="11" Margin="0,0,6,0" />
                                                <Button Content="Bỏ chọn hết" Style="{StaticResource SecondaryButton}" Command="{Binding DeselectAllScheduledAppsCommand}" Padding="8,3" FontSize="11" Margin="0,0,6,0" />
                                                <Button Content="Chỉ chọn WhatsApp" Style="{StaticResource SecondaryButton}" Command="{Binding ResetScheduledAppsToDefaultCommand}" Padding="8,3" FontSize="11" Margin="0,0,6,0" />
                                                <Button Content="🔄 Tải lại" Style="{StaticResource SecondaryButton}" Command="{Binding LoadScheduledAppsCommand}" Padding="8,3" FontSize="11" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Selection summary badge -->
                                        <TextBlock Grid.Row="1" Text="{Binding ScheduledAppsSummaryText}" FontSize="11" Foreground="#047857" FontWeight="SemiBold" Margin="0,0,0,6" />

                                        <!-- Scheduled Apps ListView with Checkbox -->
                                        <ListView Grid.Row="2" ItemsSource="{Binding ScheduledApps}" MaxHeight="220" BorderBrush="#E5E7EB">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="Bật lịch" Width="65">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Tên ứng dụng" Width="220">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Mã định danh (ID)" Width="200" DisplayMemberBinding="{Binding Id}" />
                                                    <GridViewColumn Header="Phiên bản" Width="110" DisplayMemberBinding="{Binding CurrentVersion}" />
                                                    <GridViewColumn Header="Ghi chú trạng thái" Width="280">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding WarningNote}" FontSize="11" Foreground="#B45309" TextTrimming="CharacterEllipsis" />
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </Grid>
                                </Border>

                                <!-- Task Status Overview -->
                                <Border Grid.Row="3" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Trạng thái tác vụ:" FontSize="11" Foreground="#6B7280" />
                                            <TextBlock Text="{Binding ScheduleModel.Status}" FontWeight="Bold" FontSize="12" Foreground="#111827" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Lần chạy gần nhất:" FontSize="11" Foreground="#6B7280" />
                                            <TextBlock Text="{Binding ScheduleModel.LastRunTime}" FontSize="12" Foreground="#111827" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Kết quả gần nhất:" FontSize="11" Foreground="#6B7280" />
                                            <TextBlock Text="{Binding ScheduleModel.LastResult}" FontSize="12" Foreground="#059669" FontWeight="SemiBold" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="Lần chạy tiếp theo:" FontSize="11" Foreground="#6B7280" />
                                            <TextBlock Text="{Binding ScheduleModel.NextRunTime}" FontSize="12" Foreground="#111827" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Auto-upgrade Log Modal / Viewer (if open) -->
                                <Border Grid.Row="4" Background="#FEF9C3" BorderBrush="#CA8A04" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,10,0,0" Visibility="{Binding IsScheduleLogModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="120" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <TextBlock Text="Nội dung auto-upgrade.log:" FontWeight="Bold" FontSize="12" Foreground="#854D0E" />
                                            <Button Content="✕ Đóng" Style="{StaticResource SecondaryButton}" Command="{Binding CloseScheduleLogModalCommand}" HorizontalAlignment="Right" Padding="6,2" FontSize="11" />
                                        </Grid>

                                        <TextBox Grid.Row="1" Text="{Binding ScheduleLogText}" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, monospace" FontSize="11" Background="#FFFFFF" Padding="6" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- REGISTRY POLICIES CARD -->
                        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="16,14">
                            <StackPanel>
                                <!-- Header -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="⚙️ Chính sách Windows Update qua Registry (HKLM)" FontWeight="Bold" FontSize="15" Foreground="#111827" />
                                        <TextBlock Text="Cấu hình trực tiếp các chính sách kiểm soát Windows Update, hoãn bản vá, khóa phiên bản và dịch vụ wuauserv." FontSize="12" Foreground="#6B7280" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="💾 Lưu chính sách" Command="{Binding ApplyPoliciesCommand}" Margin="0,0,8,0" Padding="14,6" />
                                        <Button Content="Khôi phục mặc định" Style="{StaticResource SecondaryButton}" Command="{Binding ResetPoliciesCommand}" Padding="10,6" />
                                    </StackPanel>
                                </Grid>

                                <!-- SECTION 1: BẢNG ĐIỀU KHIỂN WINDOWS UPDATE (CHẾ ĐỘ TƯƠNG THÍCH WUB) -->
                                <Border Background="#F9FAFB" BorderBrush="{Binding WindowsUpdateBadgeBorder}" BorderThickness="1.5" CornerRadius="6" Padding="16,14" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Header & Current Status Display -->
                                        <Grid Grid.Row="0" Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🛡️ BẢNG ĐIỀU KHIỂN WINDOWS UPDATE (WUB MODE)" FontWeight="Bold" FontSize="14" Foreground="#111827" />
                                                    <Border Background="{Binding WindowsUpdateBadgeBackground}" BorderBrush="{Binding WindowsUpdateBadgeBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding WindowsUpdateBadgeText}" FontWeight="Bold" FontSize="11" Foreground="{Binding WindowsUpdateBadgeForeground}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding WuStatus.StatusDescription}" FontSize="12" Foreground="#4B5563" Margin="0,3,0,0" />
                                            </StackPanel>

                                            <Button Grid.Column="1" Content="🔄 Làm mới" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshWindowsUpdateStatusCommand}" VerticalAlignment="Center" Padding="10,5" />
                                        </Grid>

                                        <!-- Direct Action Controls (Like WUB) -->
                                        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Nút 1: Khóa Windows Update (Disable / Block) -->
                                                <Button Command="{Binding DisableWindowsUpdateCommand}" Padding="14,7" Margin="0,0,10,0" ToolTip="Dừng và vô hiệu hóa triệt để wuauserv, WaaSMedicSvc, UsoSvc và kích hoạt NoAutoUpdate=1.">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="#DC2626" CornerRadius="4" Padding="14,7" Cursor="Hand">
                                                                <TextBlock Text="🔒 Khóa Windows Update (Disable)" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <!-- Nút 2: Bật lại Windows Update (Enable / Unblock) -->
                                                <Button Command="{Binding EnableWindowsUpdateCommand}" Padding="14,7" Margin="0,0,10,0" ToolTip="Tự động phá khóa WUB, khắc phục lỗi 'Access is denied', gỡ bỏ hạn chế quyền và kích hoạt lại dịch vụ cập nhật.">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="#059669" CornerRadius="4" Padding="14,7" Cursor="Hand">
                                                                <TextBlock Text="🔓 Bật Windows Update (Enable)" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <CheckBox Content="Bảo vệ thiết lập dịch vụ (Protect Service Settings - Chống Windows tự phục hồi)" IsChecked="{Binding IsProtectServiceSettings}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" FontWeight="SemiBold" ToolTip="Khóa quyền ACL để các tiến trình Windows không thể tự động bật lại cập nhật ngầm." />
                                            </StackPanel>
                                        </Border>

                                        <!-- Ghi chú giải thích tính năng -->
                                        <Border Grid.Row="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="10,6">
                                            <TextBlock Text="💡 Tương thích hoàn toàn với Windows Update Blocker (WUB). Ứng dụng tích hợp cơ chế tự động chiếm quyền sở hữu (Take Ownership) để phá bỏ triệt để lỗi 'Access is denied' (Exit Code 5) khi điều khiển dịch vụ." FontSize="11" Foreground="#1E40AF" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- SECTION 2: CHẾ ĐỘ CẬP NHẬT (AUOPTIONS) -->
                                <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Chế độ AU -->
                                        <StackPanel Grid.Row="1">
                                            <TextBlock Text="Chế độ tự động cập nhật (AUOptions):" FontWeight="SemiBold" FontSize="12" Foreground="#374151" Margin="0,0,0,6" />
                                            <StackPanel Orientation="Vertical">
                                                <RadioButton Content="Tắt hoàn toàn tự động cập nhật (NoAutoUpdate = 1) [Khuyên dùng cho máy chặn cập nhật]" IsChecked="{Binding PolicyModel.AuMode, Converter={x:Null}}" Margin="0,2" FontSize="12" FontWeight="SemiBold">
                                                    <RadioButton.Style>
                                                        <Style TargetType="RadioButton">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PolicyModel.AuMode}" Value="CompletelyDisabled">
                                                                    <Setter Property="IsChecked" Value="True" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </RadioButton.Style>
                                                </RadioButton>
                                                <RadioButton Content="Chỉ thông báo khi có bản cập nhật, không tự tải (NoAutoUpdate = 0, AUOptions = 2)" Margin="0,2" FontSize="12">
                                                    <RadioButton.Style>
                                                        <Style TargetType="RadioButton">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PolicyModel.AuMode}" Value="NotifyBeforeDownload">
                                                                    <Setter Property="IsChecked" Value="True" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </RadioButton.Style>
                                                </RadioButton>
                                                <RadioButton Content="Tự động tải về, nhưng hỏi trước khi cài đặt (AUOptions = 3)" Margin="0,2" FontSize="12">
                                                    <RadioButton.Style>
                                                        <Style TargetType="RadioButton">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PolicyModel.AuMode}" Value="AutoDownloadNotifyInstall">
                                                                    <Setter Property="IsChecked" Value="True" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </RadioButton.Style>
                                                </RadioButton>
                                                <RadioButton Content="Tự động tải và cài đặt (AUOptions = 4)" Margin="0,2" FontSize="12">
                                                    <RadioButton.Style>
                                                        <Style TargetType="RadioButton">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PolicyModel.AuMode}" Value="AutoDownloadAndInstall">
                                                                    <Setter Property="IsChecked" Value="True" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </RadioButton.Style>
                                                </RadioButton>
                                                <RadioButton Content="Mặc định của Windows (Xóa các khóa chính sách AU)" Margin="0,2" FontSize="12">
                                                    <RadioButton.Style>
                                                        <Style TargetType="RadioButton">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PolicyModel.AuMode}" Value="Default">
                                                                    <Setter Property="IsChecked" Value="True" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </RadioButton.Style>
                                                </RadioButton>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- SECTION 2: HOÃN & KHÓA PHIÊN BẢN (DEFER & TARGET RELEASE) -->
                                <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Hoãn cập nhật &amp; Khóa phiên bản tính năng:" FontWeight="Bold" FontSize="13" Foreground="#111827" Margin="0,0,0,10" />

                                        <!-- Defer Quality Updates -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                            <CheckBox Content="Hoãn bản cập nhật chất lượng (Quality Updates):" IsChecked="{Binding PolicyModel.DeferQualityUpdates}" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0" />
                                            <TextBox Text="{Binding PolicyModel.DeferQualityDays}" Width="50" Height="24" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                            <TextBlock Text="ngày (tối đa 30 ngày)" VerticalAlignment="Center" FontSize="12" Foreground="#6B7280" Margin="6,0,0,0" />
                                        </StackPanel>

                                        <!-- Defer Feature Updates -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                            <CheckBox Content="Hoãn bản cập nhật tính năng (Feature Updates):" IsChecked="{Binding PolicyModel.DeferFeatureUpdates}" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0" />
                                            <TextBox Text="{Binding PolicyModel.DeferFeatureDays}" Width="50" Height="24" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                            <TextBlock Text="ngày (tối đa 365 ngày)" VerticalAlignment="Center" FontSize="12" Foreground="#6B7280" Margin="6,0,0,0" />
                                        </StackPanel>

                                        <!-- Target Release Version Lock -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="Khóa phiên bản tính năng (TargetReleaseVersion):" IsChecked="{Binding PolicyModel.TargetReleaseVersionEnabled}" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0" />
                                            <TextBox Text="{Binding PolicyModel.ProductVersion}" Width="90" Height="24" VerticalContentAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="Phiên bản:" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0" />
                                            <TextBox Text="{Binding PolicyModel.TargetReleaseVersionInfo}" Width="60" Height="24" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                            <TextBlock Text="(ví dụ: 23H2)" VerticalAlignment="Center" FontSize="11" Foreground="#6B7280" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- SECTION 3: CÁC TÙY CHỌN AN TOÀN BỔ SUNG -->
                                <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Các tùy chọn an toàn bổ sung:" FontWeight="Bold" FontSize="13" Foreground="#111827" Margin="0,0,0,10" />

                                        <CheckBox Content="Không tự khởi động lại khi có người dùng đang đăng nhập (NoAutoRebootWithLoggedOnUsers)" IsChecked="{Binding PolicyModel.NoAutoRebootWithLoggedOnUsers}" FontSize="12" Margin="0,0,0,8" />
                                        <CheckBox Content="Không cài đặt Driver qua Windows Update (ExcludeWUDriversInQualityUpdate)" IsChecked="{Binding PolicyModel.ExcludeDriversInQualityUpdate}" FontSize="12" Margin="0,0,0,8" />
                                        <CheckBox Content="Tắt tự động cập nhật ứng dụng của Microsoft Store (AutoDownload = 2)" IsChecked="{Binding PolicyModel.DisableStoreAutoDownload}" FontSize="12" Margin="0,0,0,8" />

                                        <!-- Active Hours -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="Giờ hoạt động (Active Hours): từ" IsChecked="{Binding PolicyModel.ActiveHoursEnabled}" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0" />
                                            <TextBox Text="{Binding PolicyModel.ActiveHoursStart}" Width="40" Height="24" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                            <TextBlock Text="giờ đến" VerticalAlignment="Center" FontSize="12" Margin="6,0,6,0" />
                                            <TextBox Text="{Binding PolicyModel.ActiveHoursEnd}" Width="40" Height="24" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                            <TextBlock Text="giờ (không tự khởi động lại trong khoảng giờ này)" VerticalAlignment="Center" FontSize="11" Foreground="#6B7280" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ROW 2: SPLITTER / SEPARATOR -->
        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" Background="#E5E7EB" ShowsPreview="True" />

        <!-- ROW 3: REALTIME LOG PANEL -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="0,2,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Log Panel Header -->
                <Border Grid.Row="0" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="16,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Nhật ký hoạt động" FontSize="13" FontWeight="SemiBold" Foreground="#111827" />
                            <TextBlock Text="{Binding LogEntries.Count, StringFormat=' ({0} dòng)'}" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Xóa" Style="{StaticResource SecondaryButton}" Command="{Binding ClearLogsCommand}" Margin="0,0,6,0" />
                            <Button Content="Sao chép" Style="{StaticResource SecondaryButton}" Command="{Binding CopyLogsCommand}" Margin="0,0,6,0" />
                            <Button Content="Mở thư mục log" Style="{StaticResource SecondaryButton}" Command="{Binding OpenLogFolderCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Log Items List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="8">
                    <ItemsControl ItemsSource="{Binding LogEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="75" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Timestamp -->
                                    <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='HH:mm:ss'}" FontSize="11" FontFamily="Consolas, monospace" Foreground="#9CA3AF" VerticalAlignment="Top" />

                                    <!-- Level Badge -->
                                    <TextBlock Grid.Column="1" Text="{Binding Level, StringFormat='[{0}]'}" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}}" VerticalAlignment="Top" />

                                    <!-- Message Content -->
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="12" FontFamily="Consolas, Segoe UI, sans-serif" Foreground="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}}" TextWrapping="Wrap" VerticalAlignment="Top" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ROW 4: STATUS BAR -->
        <Border Grid.Row="4" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status Text -->
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="12" Foreground="#4B5563" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <!-- Indeterminate Progress when Busy -->
                <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="120" Height="14" Margin="12,0" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center" />

                <!-- Cancel Button when Busy -->
                <Button Grid.Column="2" Content="Hủy tác vụ" Style="{StaticResource DangerButton}" Command="{Binding CancelProcessCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
